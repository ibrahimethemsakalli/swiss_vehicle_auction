{
  "name": "autoveri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:local-payments": "tsx scripts/local-payment-server.mjs",
    "build": "next build --webpack",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "format": "prettier --write src tests server.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:deploy": "prisma migrate deploy",
    "admin:grant": "tsx scripts/make-admin.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:settlement": "tsx scripts/settlement-tests.ts",
    "db:seed": "tsx scripts/seed-samples.ts",
    "test:local": "tsx scripts/local-feature-tests.ts",
    "test:media": "tsx --test tests/photo-processing.test.ts && tsx scripts/media-tests.ts",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "test:legal": "tsx --test tests/legal-policy.test.ts && tsx scripts/legal-tests.ts",
    "legal:publish": "tsx scripts/publish-legal.ts",
    "test:security": "tsx scripts/account-security-tests.ts",
    "dev:local-security": "tsx scripts/local-security-server.mjs",
    "test:providers": "tsx --test tests/provider-boundaries.test.ts && tsx scripts/provider-state-tests.ts",
    "backup:create": "tsx scripts/local-backup.ts create",
    "backup:verify": "tsx scripts/local-backup.ts verify",
    "backup:restore": "tsx scripts/local-backup.ts restore",
    "test:operations": "tsx --test tests/operations.test.ts && tsx scripts/operations-tests.ts",
    "ci:typecheck": "node scripts/ci-check.mjs typecheck",
    "ci:test": "node scripts/ci-check.mjs unit",
    "ci:build": "node scripts/ci-check.mjs build",
    "ci:db": "node scripts/ci-check.mjs db",
    "audit:dependencies": "pnpm audit --audit-level high",
    "ci:lint": "node scripts/check-ci.mjs",
    "test:framework": "node scripts/ci-check.mjs unit framework-migration.test.ts && node scripts/ci-check.mjs build && tsx scripts/framework-http-tests.ts",
    "test:framework:http": "tsx scripts/framework-http-tests.ts",
    "test:validation": "node scripts/ci-check.mjs unit zod-migration.test.ts",
    "test:prisma": "node scripts/ci-check.mjs unit prisma-module.test.ts && node --import tsx scripts/prisma-security-tests.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^18.0.8",
    "i18next": "25.6.0",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "stripe": "23.0.0",
    "tailwind-merge": "2.6.0",
    "tesseract.js": "6.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  }
}
