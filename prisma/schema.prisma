generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// PM-25D isolated local fixtures. No relation to production users, bids or payments.
model LocalProxyAuction {
  capture LocalProxyCapture?
  status LocalProxyAuctionStatus @default(OPEN)
  winnerId String?
  closedAt DateTime?
  cancelledAt DateTime?
  room LocalProxyRoom?
  id String @id @default(uuid())
  sellerId String
  buyerIds String[]
  startCents BigInt
  incrementCents BigInt
  priceCents BigInt?
  leaderId String?
  startsAt DateTime
  endsAt DateTime
  version Int @default(0)
  limits LocalProxyLimit[]
  holds LocalProxyHold[]
  commands LocalProxyCommand[]
  events LocalProxyEvent[]
  @@index([status,endsAt])
}

enum LocalProxyAuctionStatus {
  COMPLETED
  OPEN
  WON
  NO_BIDS
  REVIEW
  CANCELLED
}

model LocalProxyRoom {
  auctionId String @id
  auction LocalProxyAuction @relation(fields:[auctionId],references:[id],onDelete:Cascade)
  creatorUserId String
  requestId String
  createdAt DateTime @default(now())
  members LocalProxyMember[]
  @@unique([creatorUserId,requestId])
}

model LocalProxyMember {
  auctionId String
  room LocalProxyRoom @relation(fields:[auctionId],references:[auctionId],onDelete:Cascade)
  userId String
  actorId String
  @@id([auctionId,userId])
  @@unique([auctionId,actorId])
  @@index([userId])
}

enum LocalProxyHoldStatus {
  CAPTURED
  AUTHORIZED
  RELEASED
}

model LocalProxyHold {
  capture LocalProxyCapture?
  id String @id @default(uuid())
  auctionId String
  auction LocalProxyAuction @relation(fields:[auctionId],references:[id],onDelete:Cascade)
  ownerId String
  amountCents Int @default(3000)
  currency String @default("CHF")
  gateway String @default("local-proxy")
  status LocalProxyHoldStatus @default(AUTHORIZED)
  expiresAt DateTime
  createdAt DateTime @default(now())
  releasedAt DateTime?
  limit LocalProxyLimit?
  @@index([auctionId,ownerId])
}

model LocalProxyCapture {
  refundCase LocalProxyRefundCase?
  auctionId String @id
  auction LocalProxyAuction @relation(fields:[auctionId],references:[id],onDelete:Restrict)
  holdId String @unique
  hold LocalProxyHold @relation(fields:[holdId],references:[id],onDelete:Restrict)
  amountCents Int @default(3000)
  currency String @default("CHF")
  capturedAt DateTime @default(now())
}

enum LocalProxyRefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model LocalProxyRefundCase {
  auctionId String @id
  capture LocalProxyCapture @relation(fields:[auctionId],references:[auctionId],onDelete:Restrict)
  requestedBy String
  reason String
  requestedAt DateTime @default(now())
  status LocalProxyRefundStatus @default(PENDING)
  decisionNote String?
  reviewedBy String?
  reviewedAt DateTime?
  refund LocalProxyRefund?
}

model LocalProxyRefund {
  auctionId String @id
  refundCase LocalProxyRefundCase @relation(fields:[auctionId],references:[auctionId],onDelete:Restrict)
  amountCents Int
  currency String
  refundedAt DateTime @default(now())
}

model LocalProxyLimit {
  auctionId String
  auction LocalProxyAuction @relation(fields:[auctionId],references:[id],onDelete:Cascade)
  ownerId String
  maximumCents BigInt
  holdId String @unique
  hold LocalProxyHold @relation(fields:[holdId],references:[id],onDelete:Restrict)
  updatedAt DateTime @updatedAt
  @@id([auctionId,ownerId])
}

model LocalProxyCommand {
  auctionId String
  auction LocalProxyAuction @relation(fields:[auctionId],references:[id],onDelete:Cascade)
  ownerId String
  requestId String
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  @@id([auctionId,ownerId,requestId])
}

model LocalProxyEvent {
  id String @id @default(uuid())
  auctionId String
  auction LocalProxyAuction @relation(fields:[auctionId],references:[id],onDelete:Cascade)
  version Int
  payload Json
  createdAt DateTime @default(now())
  @@unique([auctionId,version])
}

enum Role {
  PRIVATE_USER
  DEALER
  ADMIN
}

enum ListingType {
  AUCTION_7_DAYS
  FIXED_PRICE_OFFERS
}

enum VehicleStatus {
  DRAFT
  PENDING_VERIFICATION
  REJECTED
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

enum BidStatus {
  OFFER_PENDING
  OFFER_REJECTED
  OFFER_WITHDRAWN
  OFFER_EXPIRED
  ACTIVE
  OUTBID
  WON
  DEFAULTED_PENALIZED
  RELEASED
}

enum HoldStatus {
  PENDING_AUTHORIZATION
  FAILED
  CAPTURED_UNEXPECTED
  AUTHORIZED
  RELEASE_PENDING
  RELEASED
  CAPTURE_PENDING
  CAPTURED_FEE
  CAPTURED_COMPENSATION
  EXPIRED
}

model User {
 syntheticEvidenceMappings SyntheticEvidenceMapping[]
  syntheticEvidenceAttempts SyntheticEvidenceAttempt[]
  refundCases RefundCase[]
  refundDecisions RefundDecision[]
  refundActivities RefundCaseActivity[]
  refundOpenedBlocks RefundOperationalBlock[] @relation("RefundBlockOpener")
  refundResolvedBlocks RefundOperationalBlock[] @relation("RefundBlockResolver")
  supportAssignments SupportTicket[] @relation("SupportOwner")
  supportReads SupportRead[]
  supportAssignmentEvents SupportAssignment[] @relation("SupportAssignmentActor")
  supportTickets SupportTicket[]
  supportEntries SupportEntry[]
  retentionRequests RetentionReviewRequest[]
  retentionEvents RetentionReviewEvent[]
  retentionProtections RetentionProtection[] @relation("ProtectionCreator")
  retentionReviews RetentionProtection[] @relation("ProtectionReviewer")
  dealerProfile DealerProfile?
  dealerImports DealerImport[]
  @@index([createdAt,id])
  adminWorkItems AdminWorkItem[]
  listingReports ListingReport[] @relation("ListingReporter")
  authoredReviews SaleReview[] @relation("ReviewAuthor")
  receivedReviews SaleReview[] @relation("ReviewRecipient")
  reviewAppeals ReviewAppeal[]

  id                 String         @id @default(uuid())
  email              String         @unique
  phone              String         @unique
  passwordHash       String
  authVersion        Int            @default(0)
  isSample           Boolean        @default(false)
  recoveryCodes      RecoveryCode[]
  disputes           Dispute[]
  role               Role           @default(PRIVATE_USER)
  language           String         @default("de")
  isIdentityVerified Boolean        @default(false)
  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  suspendedAt        DateTime?
  swissId            String?        @unique
  canton             String?
  companyName        String?
  handelsregisterNr  String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  vehicles           Vehicle[]
  bids               Bid[]
  holds              PaymentHold[]
  media              MediaAsset[]
  legalAcceptances   LegalAcceptance[]
  accountChallenges AccountChallenge[]
  notifications Notification[]
  listingDrafts ListingDraft[]
  buyingConversations Conversation[] @relation("ConversationBuyer")
  sellingConversations Conversation[] @relation("ConversationSeller")
  chatMessages ChatMessage[]
  blocks UserBlock[] @relation("BlockOwner")
  blockedBy UserBlock[] @relation("BlockTarget")
  messageReports MessageReport[]
  savedSearches SavedSearch[]
  favorites Favorite[]
}

model DealerProfile {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  canton String
  city String
  postalCode String
  description String
  published Boolean @default(false)
  version Int @default(1)
  updatedAt DateTime @updatedAt
}

model DealerImport {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  requestId String
  contentHash String
  draftIds String[]
  createdAt DateTime @default(now())
  @@unique([userId,requestId])
}

model Conversation {
 protections RetentionProtection[]
  id String @id @default(uuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId], references:[id])
  buyerId String
  buyer User @relation("ConversationBuyer",fields:[buyerId],references:[id])
  sellerId String
  seller User @relation("ConversationSeller",fields:[sellerId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  messages ChatMessage[]
  appointments Appointment[]
  @@unique([vehicleId,buyerId])
  @@index([buyerId,createdAt,id])
  @@index([sellerId,createdAt,id])
}

model ChatMessage {
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id])
  senderId String
  sender User @relation(fields:[senderId],references:[id])
  requestId String
  body String
  hiddenAt DateTime?
  createdAt DateTime @default(now())
  reports MessageReport[]
  @@unique([senderId,requestId])
  @@index([conversationId,createdAt,id])
  @@index([senderId,createdAt])
}

model Appointment {
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id])
  proposerId String
  requestId String
  startsAt DateTime
  location String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([proposerId,requestId])
  @@index([conversationId,createdAt,id])
}

model UserBlock {
  ownerId String
  targetId String
  owner User @relation("BlockOwner",fields:[ownerId],references:[id])
  target User @relation("BlockTarget",fields:[targetId],references:[id])
  createdAt DateTime @default(now())
  @@id([ownerId,targetId])
}

model MessageReport {
  id String @id @default(uuid())
  messageId String
  message ChatMessage @relation(fields:[messageId],references:[id])
  reporterId String
  reporter User @relation(fields:[reporterId],references:[id])
  category String
  note String
  status String @default("OPEN")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([messageId,reporterId])
  @@index([status,createdAt,id])
}

model ListingDraft {
  id String @id
  ownerId String
  owner User @relation(fields:[ownerId],references:[id])
  payload Json
  step Int @default(0)
  revision Int @default(1)
  status String @default("DRAFT")
  vehicleId String? @unique
  vehicle Vehicle? @relation(fields:[vehicleId],references:[id])
  media MediaAsset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,status,updatedAt])
}

model Notification {
  supportTicketId String?
  supportTicket SupportTicket? @relation(fields:[supportTicketId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  @@index([supportTicketId])
  retentionRequestId String?
  retentionRequest RetentionReviewRequest? @relation(fields:[retentionRequestId],references:[id],onDelete:Restrict)
  @@index([retentionRequestId])
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey String
  kind String
  vehicleId String
  vehicleName String
  readAt DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, eventKey])
  @@index([userId, createdAt, id])
  @@index([userId, readAt, createdAt, id])
}

model AccountChallenge {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purpose String
  tokenHash String
  expiresAt DateTime
  @@unique([userId, purpose])
  @@index([expiresAt], map: "AccountChallenge_expiry")
}

model Vehicle {
  dataDeclaredAt DateTime?
  dataCorrectedAt DateTime?
  dataCorrectedFields String[] @default([])
  viewDays ListingViewDay[]
  @@index([createdAt,id])
  listingReports ListingReport[]

  city              String?
  postalCode        String?
  id                String        @id @default(uuid())
  isSample          Boolean       @default(false)
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  stammnummer       String
  vinChassis        String        @unique
  firstRegistration DateTime?
  modelYear         Int?
  make              String
  model             String
  fuelType String?
  transmission String?
  bodyType String?
  drivetrain String?
  condition String?
  exteriorColor String?
  accidentHistory String?
  warranty String?
  fuelConsumption Float?
  electricConsumption Float?
  co2Emissions Int?
  rangeKm Int?
  batteryCapacity Float?
  seats Int?
  doors Int?
  interiorColor String?
  energyClass String?
  euroNorm String?
  equipment String[] @default([])
  cubicCapacity     Int?
  powerKw           Int?
  mileage           Int
  canton            String
  mfkDate           DateTime?
  mfkStatus         String @default("DATED")
  damageDescription String?
  batteryHealth     Float?
  serviceHistory    String
  tireCondition     String
  description       String
  images            String[]
  listingType       ListingType
  status            VehicleStatus @default(PENDING_VERIFICATION)
  isVerifiedPrivate Boolean       @default(false)
  startPrice        Decimal       @db.Decimal(12, 2)
  reservePrice      Decimal?      @db.Decimal(12, 2)
  buyNowPrice       Decimal?      @db.Decimal(12, 2)
  minimumIncrement  Decimal       @default(100) @db.Decimal(12, 2)
  currentPrice      Decimal?      @db.Decimal(12, 2)
  auctionStartAt    DateTime?
  auctionEndsAt     DateTime?
  antiSnipingCount  Int           @default(0)
  version           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bids              Bid[]
  auctionLogs       AuctionLog[]
  holds             PaymentHold[]
  settlement        Settlement?
  media             MediaAsset[]
  conversations Conversation[]
  listingDraft ListingDraft?
  revisions ListingRevision[]
  favorites Favorite[]
  legalAcceptanceId String?
  legalAcceptance LegalAcceptance? @relation(fields: [legalAcceptanceId], references: [id], onDelete: Restrict)

  @@index([status, canton, auctionEndsAt])
  @@index([status, city])
  @@index([status, postalCode])
  @@index([status, make, model])
}

model ListingViewDay {
  id String @id @default(uuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
  day DateTime @db.Date
  viewerToken String
  @@unique([vehicleId,day,viewerToken])
  @@index([day,viewerToken])
}

model Bid {
  id             String      @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  amount         Decimal     @db.Decimal(12, 2)
  holdId         String      @unique
  hold           PaymentHold @relation(fields: [holdId], references: [id])
  requestId      String
  status         BidStatus   @default(ACTIVE)
  createdAt      DateTime    @default(now())
  offerExpiresAt DateTime?
  settlement     Settlement?
  legalAcceptanceId String?
  legalAcceptance LegalAcceptance? @relation(fields: [legalAcceptanceId], references: [id], onDelete: Restrict)

  @@unique([userId, requestId])
  @@index([vehicleId, status])
}

model Settlement {
  handoverRevisions HandoverRevision[]
  reviews SaleReview[]

  id                String    @id @default(uuid())
  vehicleId         String    @unique
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
  bidId             String    @unique
  bid               Bid       @relation(fields: [bidId], references: [id])
  status            String    @default("AWAITING_CONFIRMATION")
  outcome           String?
  sellerConfirmedAt DateTime?
  defaultReportedAt DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  disputes          Dispute[]

  @@index([status, createdAt])
}

model RecoveryCode {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Dispute {
  @@index([createdAt,id])
  id             String     @id @default(uuid())
  settlementId   String
  settlement     Settlement @relation(fields: [settlementId], references: [id])
  reporterId     String
  reporter       User       @relation(fields: [reporterId], references: [id])
  category       String
  message        String
  status         String     @default("OPEN")
  resolution     String?
  resolutionNote String?
  reviewedBy     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([settlementId, status])
}

model PaymentHold {
  refundBinding RefundCaptureBinding?
  @@index([createdAt,id])
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  vehicleId            String
  vehicle              Vehicle       @relation(fields: [vehicleId], references: [id])
  gateway              String
  replacementBidId     String?
  gatewayTransactionId String?       @unique
  amount               Decimal       @default(30) @db.Decimal(5, 2)
  currency             String        @default("CHF")
  status               HoldStatus    @default(PENDING_AUTHORIZATION)
  expiresAt            DateTime
  createdAt            DateTime      @default(now())
  bid                  Bid?
  transactions         Transaction[]
  legalAcceptanceId String?
  legalAcceptance LegalAcceptance? @relation(fields: [legalAcceptanceId], references: [id], onDelete: Restrict)
}

model Transaction {
  id                   String      @id @default(uuid())
  holdId               String
  hold                 PaymentHold @relation(fields: [holdId], references: [id])
  operation            String
  status               String      @default("PENDING")
  gatewayTransactionId String?     @unique
  idempotencyKey       String      @unique
  createdAt            DateTime    @default(now())
  attempts             Int         @default(0)
  nextAttemptAt        DateTime    @default(now())
  lockedAt             DateTime?
}

model SmsVerification {
  userId          String   @id
  verificationSid String
  expiresAt       DateTime
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model WebhookEvent {
  id          String    @id
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model AuctionLog {
  id               String   @id @default(uuid())
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  extensionSeconds Int      @default(120)
  triggeredAt      DateTime @default(now())
}

model OutboxEvent {
  @@index([kind,createdAt,id])
  id          String    @id @default(uuid())
  kind        String
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([deliveredAt, createdAt])
}

model MediaAsset {
  id        String   @id @default(uuid())
  filename  String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicleId String?
  draftId String?
  draft ListingDraft? @relation(fields:[draftId],references:[id])
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status    String   @default("STAGING")
  bytes     Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([ownerId, status])
  @@index([status, vehicleId, createdAt])
}

model LegalRelease {
  id String @id @default(uuid())
  version String @unique
  publishedAt DateTime @default(now())
  documents LegalDocument[]
  current LegalCurrent?
  acceptances LegalAcceptance[]
}

model LegalCurrent {
  id String @id @default("current")
  releaseId String @unique
  release LegalRelease @relation(fields:[releaseId],references:[id])
}

model LegalDocument {
  id String @id @default(uuid())
  releaseId String
  release LegalRelease @relation(fields:[releaseId],references:[id])
  kind String
  locale String
  title String
  content Json
  contentHash String
  termsAcceptances LegalAcceptance[] @relation("AcceptedTerms")
  privacyAcknowledgements LegalAcceptance[] @relation("AcknowledgedPrivacy")

  @@unique([releaseId,kind,locale])
}

model LegalAcceptance {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  releaseId String
  release LegalRelease @relation(fields:[releaseId],references:[id])
  termsDocumentId String
  termsDocument LegalDocument @relation("AcceptedTerms",fields:[termsDocumentId],references:[id])
  privacyDocumentId String
  privacyDocument LegalDocument @relation("AcknowledgedPrivacy",fields:[privacyDocumentId],references:[id])
  locale String
  source String
  termsAccepted Boolean
  privacyAcknowledged Boolean
  eligibilityDeclared Boolean
  acceptedAt DateTime @default(now())
  vehicles Vehicle[]
  bids Bid[]
  holds PaymentHold[]

  @@unique([userId,releaseId])
  @@index([userId,acceptedAt])
}

model ListingRevision {
 id String @id @default(uuid())
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
 version Int
 action String
 note String
 corrections String[]
 snapshot Json
 createdAt DateTime @default(now())
 @@unique([vehicleId, version, action])
 @@index([vehicleId, createdAt])
}

model Favorite {
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@id([userId,vehicleId])
 @@index([userId,createdAt])
}

model SavedSearch {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  filters Json
  alerts Boolean @default(false)
  createdAt DateTime @default(now())
  checkedAt DateTime @default(now())
  checkedId String @default("")
  @@unique([userId,name])
  @@index([alerts,checkedAt,id])
}

model ListingReport {
 id String @id @default(uuid())
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:NoAction)
 reporterId String
 reporter User @relation("ListingReporter",fields:[reporterId],references:[id],onDelete:NoAction)
 category String
 note String
 status String @default("OPEN")
 decision String?
 decisionNote String?
 reviewedBy String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([vehicleId,reporterId])
 @@index([status,createdAt,id])
 @@index([reporterId,createdAt,id])
}
model SaleReview {
 id String @id @default(uuid())
 settlementId String
 settlement Settlement @relation(fields:[settlementId],references:[id],onDelete:NoAction)
 authorId String
 author User @relation("ReviewAuthor",fields:[authorId],references:[id],onDelete:NoAction)
 recipientId String
 recipient User @relation("ReviewRecipient",fields:[recipientId],references:[id],onDelete:NoAction)
 rating Int
 note String
 response String?
 responseAt DateTime?
 status String @default("PUBLISHED")
 createdAt DateTime @default(now())
 appeal ReviewAppeal?
 @@unique([settlementId,authorId])
 @@index([recipientId,status,createdAt,id])
}
model ReviewAppeal {
 id String @id @default(uuid())
 reviewId String @unique
 review SaleReview @relation(fields:[reviewId],references:[id],onDelete:NoAction)
 reporterId String
 reporter User @relation(fields:[reporterId],references:[id],onDelete:NoAction)
 note String
 status String @default("OPEN")
 decision String?
 decisionNote String?
 reviewedBy String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 @@index([status,createdAt,id])
}

model RetentionProtection {
 id String @id @default(uuid())
 conversationId String
 status String @default("ACTIVE")
 version Int @default(1)
 releasedAt DateTime?
 requests RetentionReviewRequest[]
 events RetentionReviewEvent[]
 conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Restrict)
 reason String
 createdById String
 createdBy User @relation("ProtectionCreator",fields:[createdById],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 reviewedById String?
 reviewedBy User? @relation("ProtectionReviewer",fields:[reviewedById],references:[id],onDelete:Restrict)
 reviewedAt DateTime?
 reviewNote String?
 @@index([reviewedAt,id])
 @@index([conversationId,status])
}

model RetentionReviewRequest {
 notifications Notification[]
 id String @id @default(uuid())
 protectionId String
 protection RetentionProtection @relation(fields:[protectionId],references:[id],onDelete:Restrict)
 requesterId String
 requester User @relation(fields:[requesterId],references:[id],onDelete:Restrict)
 reasonCode String
 note String
 evidence Json
 snapshot String
 protectionVersion Int
 version Int @default(1)
 status String @default("OPEN")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events RetentionReviewEvent[]
 @@index([protectionId,createdAt,id])
}

model RetentionReviewEvent {
 id String @id @default(uuid())
 protectionId String
 protection RetentionProtection @relation(fields:[protectionId],references:[id],onDelete:Restrict)
 requestId String?
 request RetentionReviewRequest? @relation(fields:[requestId],references:[id],onDelete:Restrict)
 actorId String
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 kind String
 payload Json
 commandId String
 commandHash String
 createdAt DateTime @default(now())
 @@unique([actorId,commandId])
 @@index([protectionId,createdAt,id])
}

model AdminWorkItem {
 id String @id @default(uuid())
 kind String
 recordId String
 ownerId String?
 owner User? @relation(fields:[ownerId],references:[id],onDelete:Restrict)
