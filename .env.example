# For local development, pnpm db:local creates .env with a generated DB password.
# For an existing server, configure its connection string instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/autoveri
# Prisma 7 node-postgres pool defaults; optional positive integers.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=10000
# Separate read-only preview/HTTP hosts can disable all business workers.
# Leave unset on the normal server; its default is enabled when DATABASE_URL exists.
# BACKGROUND_WORKERS_ENABLED=false
# schema=public remains supported. Replace legacy connection_limit/pool_timeout/
# connect_timeout URL flags with these settings. TLS verification stays enabled.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
OCR_ENABLED=false
# Stripe test keys. NEXT_PUBLIC value is intentionally public and embedded at build time.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Live charging is disabled unless explicitly enabled.
STRIPE_ALLOW_LIVE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Local security simulation only; enabled by pnpm dev:local-security.
LOCAL_TEST_MESSAGES=false
# Optional PM-06 local operations paths (keep outside public/).
# OPERATIONS_DIR=C:/path/to/private-worker-state
# PG_BIN=C:/path/to/postgresql/bin
# RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/autoveri_restore_rehearsal_test
# RESTORE_UPLOAD_DIR=C:/absolute/project/.local/restores/rehearsal
# Optional isolated integration database; database name must end in _test.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/autoveri_test
# Required in production: an absolute path to durable storage for public vehicle photos.
# UPLOAD_DIR=C:/path/to/autoveri-uploads
